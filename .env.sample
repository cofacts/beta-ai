GOOGLE_GENAI_USE_VERTEXAI=

# If use Vertex AI, set the project and location
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# If not using Vertex AI, set the API key
GOOGLE_API_KEY=

# Hackmd Agent tools
GITHUB_PERSONAL_ACCESS_TOKEN=
HACKMD_API_URL=
HACKMD_API_TOKEN=
DISCORD_TOKEN=

# Langfuse / OpenTelemetry
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key"
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key"
LANGFUSE_BASE_URL="https://langfuse.cofacts.tw"

# LiteLLM
OPENAI_API_KEY=

# URL benchmark (scripts/url_benchmark.py)
# CLOUDFLARE_API_TOKEN: create at https://dash.cloudflare.com/profile/api-tokens
#   Permission: Account → Browser Rendering → Edit
#   Account Resources: Include → Specific account (Cofacts)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
URL_RESOLVER_GRPC_ENDPOINT=localhost:4000
